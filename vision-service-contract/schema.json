{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FareegVisionServiceContract",
  "description": "API Schema Contract for FAREEG AI external Python FastAPI Computer Vision Service",
  "version": "1.0.0",
  "definitions": {
    "GameType": {
      "type": "string",
      "enum": ["football", "al_teela", "al_dama", "al_laqaf", "qif"]
    },
    "BoundingBox": {
      "type": "object",
      "properties": {
        "x": { "type": "number", "description": "Normalized x coordinate (0 to 1)" },
        "y": { "type": "number", "description": "Normalized y coordinate (0 to 1)" },
        "width": { "type": "number", "description": "Normalized width (0 to 1)" },
        "height": { "type": "number", "description": "Normalized height (0 to 1)" }
      },
      "required": ["x", "y", "width", "height"]
    },
    "VisionDetectedEvent": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string" },
        "match_id": { "type": "string" },
        "game": { "$ref": "#/definitions/GameType" },
        "event_type": { "type": "string" },
        "timestamp_seconds": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "team_id": { "type": "string" },
        "player_id": { "type": "string" },
        "review_status": { "type": "string", "enum": ["pending", "confirmed", "rejected"], "default": "pending" },
        "evidence_frame_url": { "type": "string" },
        "bounding_box": { "$ref": "#/definitions/BoundingBox" },
        "metadata": {
          "type": "object",
          "properties": {
            "detector_name": { "type": "string" },
            "detector_version": { "type": "string" },
            "frame_index": { "type": "integer" },
            "notes": { "type": "string" }
          }
        }
      },
      "required": ["event_type", "timestamp_seconds", "confidence"]
    },
    "AnalysisRequest": {
      "type": "object",
      "properties": {
        "match_id": { "type": "string" },
        "game": { "$ref": "#/definitions/GameType" },
        "video_url": { "type": "string" },
        "webhook_url": { "type": "string" },
        "camera_params": {
          "type": "object",
          "properties": {
            "perspective": { "type": "string", "enum": ["overhead", "sideline_wide", "closeup_hands", "high_angle"] },
            "resolution": { "type": "string" }
          }
        }
      },
      "required": ["match_id", "game", "video_url"]
    },
    "AnalysisResponse": {
      "type": "object",
      "properties": {
        "job_id": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "processing", "completed", "failed"] },
        "detector_loaded": { "type": "string" }
      },
      "required": ["job_id", "status"]
    }
  }
}
